generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  email         String    @unique
  password      String

  level         Int @default(1)
  exp           Int @default(0)
  currentStreak Int @default(0)
  longestStreak Int @default(0)

  avatar        String?
  bio           String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}